# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/royal_upholstery
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/royal_upholstery?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/royal_upholstery

# JWT Secret for Admin Authentication
JWT_SECRET=royal_upholstery_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Default Admin Credentials for Seeding
ADMIN_EMAIL=admin@royalupholstery.ae
ADMIN_PASSWORD=admin123
